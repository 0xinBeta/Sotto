{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.13.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @sotto/extension build",
    "typecheck": "pnpm -r --filter './packages/**' build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --filter './packages/**' build && vitest run",
    "evals": "pnpm --filter @sotto/core build && pnpm --filter @sotto/evals eval"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "24.3.0",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "kokoro-js@1.2.1": "patches/kokoro-js@1.2.1.patch"
    }
  }
}
