{
  "name": "@sotto/tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kokoro": {
      "types": "./dist/kokoro.d.ts",
      "import": "./dist/kokoro.js"
    },
    "./kokoro-voices": {
      "types": "./dist/kokoro-voices.d.ts",
      "import": "./dist/kokoro-voices.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "kokoro-js": "1.2.1"
  }
}
