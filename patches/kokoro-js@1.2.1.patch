index 0000000000000000000000000000000000000000..d5183f7a345c67e443b95ad404917f6d7a830938
--- /dev/null
+++ b/dist/kokoro.pinned.js
@@ -0,0 +1,60 @@
+import {
+  KokoroTTS as UpstreamKokoroTTS,
+  TextSplitterStream,
+  env,
+} from "./kokoro.js";
+
+const PINNED_MODEL_ID = "onnx-community/Kokoro-82M-v1.0-ONNX";
+const PINNED_REVISION = "1939ad2a8e416c0acfeecc08a694d14ef25f2231";
+const MAIN_PREFIX =
+  `https://huggingface.co/${PINNED_MODEL_ID}/resolve/main/`;
+const PINNED_PREFIX =
+  `https://huggingface.co/${PINNED_MODEL_ID}/resolve/${PINNED_REVISION}/`;
+
+let pinnedFetchInstalled = false;
+
+function installPinnedFetch() {
+  if (pinnedFetchInstalled || typeof globalThis.fetch !== "function") {
+    return;
+  }
+
+  const upstreamFetch = globalThis.fetch.bind(globalThis);
+  globalThis.fetch = (input, init) => {
+    const url =
+      typeof input === "string"
+        ? input
+        : input instanceof URL
+          ? input.href
+          : input.url;
+    if (!url.startsWith(MAIN_PREFIX)) {
+      return upstreamFetch(input, init);
+    }
+
+    const pinnedUrl = `${PINNED_PREFIX}${url.slice(MAIN_PREFIX.length)}`;
+    if (typeof input === "string") {
+      return upstreamFetch(pinnedUrl, init);
+    }
+    if (input instanceof URL) {
+      return upstreamFetch(new URL(pinnedUrl), init);
+    }
+    return upstreamFetch(new Request(pinnedUrl, input), init);
+  };
+  pinnedFetchInstalled = true;
+}
+
+class KokoroTTS extends UpstreamKokoroTTS {
+  static from_pretrained(modelId, options = {}) {
+    const { revision = PINNED_REVISION, ...upstreamOptions } = options;
+    if (modelId === PINNED_MODEL_ID) {
+      if (revision !== PINNED_REVISION) {
+        throw new Error(
+          `Kokoro revision must be pinned to ${PINNED_REVISION}`,
+        );
+      }
+      installPinnedFetch();
+    }
+    return UpstreamKokoroTTS.from_pretrained(modelId, upstreamOptions);
+  }
+}
+
+export { KokoroTTS, TextSplitterStream, env };
